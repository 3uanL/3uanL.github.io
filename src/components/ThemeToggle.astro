---
/**
 * 主题切换按钮：三态循环 —— 跟随系统 → 浅色 → 深色 → 跟随系统。
 * 实际的切换逻辑放在页面底部的一小段脚本里（见下方 <script>）。
 */
---

<button id="theme-toggle" class="theme-toggle" type="button" title="Switch theme" aria-label="Switch theme">
  <span class="theme-icon theme-icon--auto" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor" stroke="none"></path>
    </svg>
  </span>
  <span class="theme-icon theme-icon--light" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
      <circle cx="12" cy="12" r="4.2"></circle>
      <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4"></path>
    </svg>
  </span>
  <span class="theme-icon theme-icon--dark" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
      <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"></path>
    </svg>
  </span>
  <span id="theme-label" class="theme-label">Auto</span>
</button>

<style>
  .theme-icon {
    display: none;
  }

  /* 三态图标：由 <html data-theme-source> 决定显示哪个 */
  :global(html[data-theme-source='auto']) .theme-icon--auto,
  :global(html[data-theme-source='light']) .theme-icon--light,
  :global(html[data-theme-source='dark']) .theme-icon--dark {
    display: inline-flex;
  }

  .theme-label {
    font-size: 0.8rem;
  }

  @media (max-width: 34rem) {
    .theme-label {
      display: none;
    }
  }
</style>

<script>
  const ORDER = ['auto', 'light', 'dark'] as const;
  type ThemeChoice = (typeof ORDER)[number];

  const root = document.documentElement;
  const button = document.getElementById('theme-toggle');
  const label = document.getElementById('theme-label');
  const media = window.matchMedia('(prefers-color-scheme: dark)');

  function readChoice(): ThemeChoice {
    const saved = localStorage.getItem('theme');
    return saved === 'light' || saved === 'dark' ? saved : 'auto';
  }

  function apply(choice: ThemeChoice) {
    const resolved = choice === 'auto' ? (media.matches ? 'dark' : 'light') : choice;
    root.dataset.theme = resolved;
    root.dataset.themeSource = choice;
    if (label) label.textContent = choice === 'auto' ? 'Auto' : choice === 'light' ? 'Light' : 'Dark';
  }

  // 系统主题变化时，只有在「跟随系统」模式下才跟着变
  media.addEventListener('change', () => {
    if (readChoice() === 'auto') apply('auto');
  });

  button?.addEventListener('click', () => {
    const next = ORDER[(ORDER.indexOf(readChoice()) + 1) % ORDER.length];
    if (next === 'auto') localStorage.removeItem('theme');
    else localStorage.setItem('theme', next);
    apply(next);
  });

  apply(readChoice());
</script>
