---
/**
 * 项目/论文条目（横向精简版）：
 *   左：配图（200px 宽，4:3 白底，contain 不裁切）
 *   右：标题 + 一句话 + 作者/venue（有 DOI 时整块可点）
 * 没有配图的项目会自动变成单栏文字。
 */
import type { Project } from '../data/projects';
import { publicationForProject } from '../data/publications';
import { site } from '../config';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const pub = publicationForProject(project.id);
const doi = pub?.links?.doi;
const href = doi ?? undefined;

const STATUS_LABEL: Record<string, string> = {
  published: 'Published',
  accepted: 'Accepted',
  submitted: 'Submitted',
  'under-review': 'Under review',
  preprint: 'Preprint',
  'in-prep': 'In preparation',
};

const authorParts = pub ? pub.authors.split(site.name) : [];
---

<article class="proj">
  {
    project.figure && (
      <div class="proj__thumb">
        {href ? (
          <a href={href} aria-label={project.title}>
            <img
              src={project.figure}
              alt={project.figureCaption ?? project.title}
              loading="lazy"
            />
          </a>
        ) : (
          <img src={project.figure} alt={project.figureCaption ?? project.title} loading="lazy" />
        )}
      </div>
    )
  }

  <div class="proj__body">
    <h3 class="proj__title">
      {href ? <a href={href}>{project.title}</a> : project.title}
    </h3>

    <p class="proj__summary">{project.summary}</p>

    {
      pub ? (
        <p class="proj__pub">
          <span class="proj__authors">
            {authorParts.map((part, idx) => (
              <>
                {part}
                {idx < authorParts.length - 1 && <strong>{site.name}</strong>}
              </>
            ))}
          </span>
          <br />
          <em>{pub.venue}</em>, {pub.year}.{' '}
          <span class={pub.status === 'in-prep' ? 'tag tag--muted' : 'tag'}>
            {STATUS_LABEL[pub.status]}
          </span>
          {pub.note && <span class="tag tag--muted">{pub.note}</span>}
          {doi && (
            <>
              {' '}
              <a class="proj__doi" href={doi}>
                DOI
              </a>
            </>
          )}
        </p>
      ) : (
        <p class="proj__pub">
          {project.lab && <>{project.lab} · </>}
          {project.period}
          {project.role && <> · {project.role}</>}
        </p>
      )
    }
  </div>
</article>

<style>
  .proj {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
    padding: 1.35rem 0;
    border-bottom: 1px solid var(--border);
  }

  .proj:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .proj:has(.proj__thumb) {
    grid-template-columns: 200px minmax(0, 1fr);
  }

  .proj__thumb {
    aspect-ratio: 16 / 9;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    display: grid;
    place-items: center;
  }

  .proj__thumb a {
    display: block;
    width: 100%;
    height: 100%;
  }

  .proj__thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 4px;
  }

  .proj__title {
    font-family: var(--font-sans);
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.4;
    margin: 0 0 0.4rem;
  }

  .proj__title a {
    color: var(--text);
  }

  .proj__title a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .proj__summary {
    font-size: 0.93rem;
    color: var(--text-muted);
    margin: 0 0 0.55rem;
    line-height: 1.6;
  }

  .proj__pub {
    font-size: 0.82rem;
    color: var(--text-faint);
    margin: 0;
    line-height: 1.7;
  }

  .proj__authors strong {
    color: var(--text);
    font-weight: 700;
  }

  .proj__doi {
    white-space: nowrap;
    font-weight: 600;
  }

  /* 没有配图的项目：整行给文字 */
  .proj:not(:has(.proj__thumb)) {
    grid-template-columns: minmax(0, 1fr);
  }

  @media (max-width: 40rem) {
    .proj,
    .proj:has(.proj__thumb) {
      grid-template-columns: 9rem minmax(0, 1fr);
      gap: 1rem;
    }
  }
</style>
