---
/**
 * Learning Log 的阅读布局：三栏（左侧目录树 + 中间正文 + 右侧本页目录）。
 * 目录树按领域折叠，只自动展开当前所在的领域。
 */
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { domains, coursesOf } from '../data/learning';
import '../styles/learning.css';

interface PagerLink {
  href: string;
  title: string;
}

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  domain?: string;
  course?: string;
  noteId?: string;
  crumb?: string;
  prev?: PagerLink;
  next?: PagerLink;
  /** 本页的小节目录（由 render() 返回的 headings） */
  headings?: Heading[];
}

const { title, description, domain, course, noteId, crumb, prev, next, headings = [] } = Astro.props;

const notes = await getCollection('learning', ({ data }) => !data.draft);

const tree = domains.map((d) => ({
  ...d,
  courses: coursesOf(d.slug).map((c) => ({
    ...c,
    notes: notes
      .filter((n) => {
        const [dn, cn] = n.id.split('/');
        return dn === d.slug && cn === c.slug;
      })
      .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title)),
  })),
}));

const here = Astro.url.pathname.replace(/\/$/, '');
const at = (path: string) => (here === path.replace(/\/$/, '') ? ('page' as const) : undefined);
const total = notes.length;

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout
  title={title}
  description={description ?? 'A learning log: notes on papers, math, communications and AI.'}
>
  <div class="container container--docs">
    <div class="docs">
      <aside class="docs__sidebar" aria-label="Learning Log contents">
        <a class="docs__home" href="/learning">Learning Log</a>

        {
          tree.map((d) => {
            const isCurrent = d.slug === domain;
            return (
              <details class="docs__group" open={isCurrent}>
                <summary class="docs__domain">{d.title}</summary>
                <div class="docs__course">
                  <a
                    class="docs__overview"
                    href={`/learning/${d.slug}`}
                    aria-current={at(`/learning/${d.slug}`)}
                  >
                    Overview
                  </a>
                  {d.courses.map((c) => (
                    <div class="docs__course-block">
                      <a
                        class="docs__course-title"
                        href={`/learning/${d.slug}/${c.slug}`}
                        aria-current={at(`/learning/${d.slug}/${c.slug}`)}
                      >
                        {c.title}
                      </a>
                      {c.notes.length > 0 && (
                        <ul class="docs__notes">
                          {c.notes.map((n) => (
                            <li>
                              <a
                                href={`/learning/${d.slug}/${c.slug}/${n.id.split('/').slice(2).join('/')}`}
                                aria-current={noteId === n.id ? 'page' : undefined}
                              >
                                {n.data.title}
                              </a>
                            </li>
                          ))}
                        </ul>
                      )}
                    </div>
                  ))}
                </div>
              </details>
            );
          })
        }
        <p class="docs__count">
          {total} note{total === 1 ? '' : 's'} so far
        </p>
      </aside>

      <div class="docs__content">
        <nav class="docs__breadcrumb" aria-label="Breadcrumb">
          <a href="/learning">Learning Log</a>
          {
            domain && (
              <>
                <span>/</span>
                <a href={`/learning/${domain}`}>
                  {domains.find((d) => d.slug === domain)?.title ?? domain}
                </a>
              </>
            )
          }
          {
            course && (
              <>
                <span>/</span>
                <a href={`/learning/${domain}/${course}`}>
                  {coursesOf(domain!).find((c) => c.slug === course)?.title ?? course}
                </a>
              </>
            )
          }
          {
            crumb && (
              <>
                <span>/</span>
                <span style="color:var(--text-muted)">{crumb}</span>
              </>
            )
          }
        </nav>

        <h1 class="docs__title">{title}</h1>
        {description && <p class="docs__lede">{description}</p>}

        <slot />

        {
          (prev || next) && (
            <nav class="docs__pager" aria-label="Previous and next">
              {prev ? (
                <a href={prev.href}>
                  <span class="docs__pager-label">← Previous</span>
                  {prev.title}
                </a>
              ) : (
                <span />
              )}
              {next && (
                <a class="docs__pager-next" href={next.href}>
                  <span class="docs__pager-label">Next →</span>
                  {next.title}
                </a>
              )}
            </nav>
          )
        }
      </div>

      <aside class="docs__toc" aria-label="On this page">
        {
          toc.length > 0 && (
            <>
              <p class="docs__toc-title">On this page</p>
              <ul>
                {toc.map((h) => (
                  <li class={`docs__toc-h${h.depth}`}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ul>
            </>
          )
        }
      </aside>
    </div>
  </div>
</BaseLayout>
