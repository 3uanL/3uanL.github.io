---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects';
---

<BaseLayout
  title="Research"
  description="Research and selected projects of Yuanhao Liu: UAV trajectory design, ISAC beamforming, magnetic localization, soft robotics, and more."
>
  <div class="container">
    <h1>Research</h1>
    <p style="color:var(--text-muted);margin-bottom:2.5rem">
      Wireless systems and learning, mostly: making communication networks aware of the physics
      around them, and letting sensing and communication share one spectrum safely. Entries that
      became papers link straight to the paper.
    </p>

    <div>
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>
</BaseLayout>
