---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects';
---

<BaseLayout
  title="Research"
  description="Research and selected projects of Yuanhao Liu: UAV trajectory design, ISAC beamforming, magnetic localization, soft robotics, and more."
>
  <div class="container">
    <h1>Research</h1>
    <p style="color:var(--text-muted)">
      I work on the boundary between wireless systems and learning: making communication networks
      aware of the physics around them, and making sensing and communication share the same spectrum
      safely. Every entry below has a detail page; the ones that turned into papers show the
      publication line directly.
    </p>

    <div class="card-grid" style="margin-top:2rem">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>
</BaseLayout>
